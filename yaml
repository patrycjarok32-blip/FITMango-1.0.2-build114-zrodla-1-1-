
workflows:
  fitmango-1-1-0-build115:
    name: FITMango 1.1.0 - Build 115

    max_build_duration: 120

    environment:
      instance_type: linux_x2
      java: 21

    scripts:
      - name: Check Java and Gradle
        script: |
          java -version
          chmod +x gradlew
          ./gradlew --version

      - name: Build FITMango APK
        script: |
          ./gradlew --no-daemon :app:assembleDebug

      - name: Check APK
        script: |
          test -s app/build/outputs/apk/debug/app-debug.apk
          echo "FITMango APK created successfully"

    artifacts:
      - app/build/outputs/apk/debug/*.apk
      - app/build/outputs/logs/*.txt
