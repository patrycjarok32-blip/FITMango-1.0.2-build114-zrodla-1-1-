<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="12dp" android:background="@drawable/mango_widget_background">
    <TextView android:id="@+id/widget_icon" android:layout_width="42dp"
        android:layout_height="wrap_content" android:textSize="26sp"
        android:gravity="center" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#21583B"
            android:textSize="15sp" android:textStyle="bold" android:maxLines="1"
            android:ellipsize="end" />
        <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#355E47"
            android:textSize="11sp" android:paddingTop="3dp" android:maxLines="2" />
    </LinearLayout>
</LinearLayout>
